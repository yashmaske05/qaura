{
  "name": "qaura",
  "productName": "QAura",
  "version": "1.0.0",
  "description": "QAura, the QA workspace: an offline desktop notepad for QA and software testers. Daily tasks, rich-text notes, bug logs, code snippets, standup summaries and a files library with Word and Excel editing and version history.",
  "author": "Yash Maske",
  "license": "MIT",
  "homepage": "https://github.com/yashmaske05/qaura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashmaske05/qaura.git"
  },
  "bugs": {
    "url": "https://github.com/yashmaske05/qaura/issues"
  },
  "keywords": [
    "qa",
    "testing",
    "software-testing",
    "notepad",
    "notes",
    "bug-tracker",
    "test-management",
    "electron",
    "desktop-app",
    "offline",
    "windows"
  ],
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/run-electron.js .",
    "test": "node test/smoke.js",
    "icon": "node scripts/run-electron.js scripts/make-icon.js",
    "package": "node scripts/vendor.js && node scripts/package.js",
    "install-app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install.ps1",
    "postinstall": "node scripts/vendor.js"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@electron/packager": "^20.3.0",
    "@highlightjs/cdn-assets": "^11.12.0",
    "docx": "^9.11.0",
    "dompurify": "^3.4.17",
    "electron": "^44.7.2",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "playwright-core": "^1.64.0"
  }
}
